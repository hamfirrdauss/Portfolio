{
  "cleanUrls": true,
  "headers": [
    { "source": "/content.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(core.js|styles.css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/edit/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
